---
profile: moderate

# ansible-lint needs explicit role search paths when playbooks live under
# ansible/playbooks/ and roles under ansible/roles/ at the project root.
# The pre-commit hook runs from the repo root, so role resolution comes from
# the root ansible.cfg (roles_path = ansible/roles). CI sets the equivalent
# ANSIBLE_ROLES_PATH while running from the ansible/ directory.

exclude_paths:
  - ansible/collections/ansible_collections/
  - .venv/
  - .omc/
